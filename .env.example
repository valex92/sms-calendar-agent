# Server Configuration
PORT=8000
HOST=0.0.0.0

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555550100

# Security: Comma-separated list of allowed phone numbers
ALLOWED_PHONE_NUMBERS=+15555550101,+15555550102

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key

# Google Calendar Configuration
# You will also need a credentials.json file in the project root
# and after the first run, a token.json will be generated.
TARGET_CALENDAR_ID=primary

# Work emails to invite when you say "add our work calendars" (comma-separated)
WORK_EMAILS=you@example.com,partner@example.com
